module dvi_tx_ext (
  hclk,
  hclk5,
  n114_o_8,
  o_hs,
  o_vs,
  o_de,
  u_ascal_o_b,
  u_ascal_o_g,
  u_ascal_o_r,
  tmds_clk_p,
  tmds_clk_n,
  tmds_d_p,
  tmds_d_n
)
;
input hclk;
input hclk5;
input n114_o_8;
input o_hs;
input o_vs;
input o_de;
input [7:0] u_ascal_o_b;
input [7:0] u_ascal_o_g;
input [7:0] u_ascal_o_r;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_d_p;
output [2:0] tmds_d_n;
wire n292_5;
wire [2:0] tmds_d;
wire [9:0] tmds_blue;
wire [9:0] tmds_green;
wire [9:0] tmds_red;
wire VCC;
wire GND;
  ELVDS_OBUF \tmds_bufds[3]  (
    .O(tmds_clk_p),
    .OB(tmds_clk_n),
    .I(hclk) 
);
  ELVDS_OBUF \tmds_bufds[2]  (
    .O(tmds_d_p[2]),
    .OB(tmds_d_n[2]),
    .I(tmds_d[2]) 
);
  ELVDS_OBUF \tmds_bufds[1]  (
    .O(tmds_d_p[1]),
    .OB(tmds_d_n[1]),
    .I(tmds_d[1]) 
);
  ELVDS_OBUF \tmds_bufds[0]  (
    .O(tmds_d_p[0]),
    .OB(tmds_d_n[0]),
    .I(tmds_d[0]) 
);
  OSER10 tmds_serdes_blue (
    .Q(tmds_d[0]),
    .D0(tmds_blue[0]),
    .D1(tmds_blue[1]),
    .D2(tmds_blue[2]),
    .D3(tmds_blue[3]),
    .D4(tmds_blue[4]),
    .D5(tmds_blue[5]),
    .D6(tmds_blue[6]),
    .D7(tmds_blue[7]),
    .D8(tmds_blue[8]),
    .D9(tmds_blue[9]),
    .PCLK(hclk),
    .FCLK(hclk5),
    .RESET(n114_o_8) 
);
  OSER10 tmds_serdes_green (
    .Q(tmds_d[1]),
    .D0(tmds_green[0]),
    .D1(tmds_green[1]),
    .D2(tmds_green[2]),
    .D3(tmds_green[3]),
    .D4(tmds_green[4]),
    .D5(tmds_green[5]),
    .D6(tmds_green[6]),
    .D7(tmds_green[7]),
    .D8(tmds_green[8]),
    .D9(tmds_green[9]),
    .PCLK(hclk),
    .FCLK(hclk5),
    .RESET(n114_o_8) 
);
  OSER10 tmds_serdes_red (
    .Q(tmds_d[2]),
    .D0(tmds_red[0]),
    .D1(tmds_red[1]),
    .D2(tmds_red[2]),
    .D3(tmds_red[3]),
    .D4(tmds_red[4]),
    .D5(tmds_red[5]),
    .D6(tmds_red[6]),
    .D7(tmds_red[7]),
    .D8(tmds_red[8]),
    .D9(tmds_red[9]),
    .PCLK(hclk),
    .FCLK(hclk5),
    .RESET(n114_o_8) 
);
  tmds_channel ch_blue (
    .hclk(hclk),
    .o_hs(o_hs),
    .o_vs(o_vs),
    .o_de(o_de),
    .u_ascal_o_b(u_ascal_o_b[7:0]),
    .n292_5(n292_5),
    .tmds_blue(tmds_blue[9:0])
);
  tmds_channel_0 ch_green (
    .hclk(hclk),
    .n292_5(n292_5),
    .u_ascal_o_g(u_ascal_o_g[7:0]),
    .tmds_green(tmds_green[9:0])
);
  tmds_channel_1 ch_red (
    .hclk(hclk),
    .n292_5(n292_5),
    .u_ascal_o_r(u_ascal_o_r[7:0]),
    .tmds_red(tmds_red[9:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* dvi_tx_ext */
